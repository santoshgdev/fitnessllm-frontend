{
  "hosting": [
    {
      "target": "dev",
      "public": "fitness_l_l_m/build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "prod",
      "public": "fitness_l_l_m/build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "functions": {
    "source": "fitness_l_l_m/firebase/custom_cloud_functions",
    "predeploy": [
      "cd \"$RESOURCE_DIR\" && npm install"
    ]
  }
}