{
  "hosting": [
    {
      "target": "dev",
      "public": ".",
      "rewrites": [
        { "source": "!**/*.mjs", "destination": "/index.html" },
        { "source": "!**/*.css", "destination": "/index.html" },
        { "source": "!**/*.js", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "**/*.css",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/css"
            }
          ]
        },
        {
          "source": "**/*.mjs",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/javascript"
            }
          ]
        }
      ]
    },
    {
      "target": "prod",
      "public": ".",
      "rewrites": [
        { "source": "!**/*.mjs", "destination": "/index.html" },
        { "source": "!**/*.css", "destination": "/index.html" },
        { "source": "!**/*.js", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "**/*.css",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/css"
            }
          ]
        },
        {
          "source": "**/*.mjs",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/javascript"
            }
          ]
        }
      ]
    }
  ]
}
